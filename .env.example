# --- Core ---
# Public site URL — used for SEO (canonical URLs, Open Graph, sitemap).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# This is a frontend-only build (no database/CMS). Wire your own delivery for the
# contact/newsletter forms in src/app/actions/* (email, CRM or webhook) when needed.

# Contact / newsletter delivery (server-side only). Forms report "unavailable" when unset.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Aadhya Infotech Website <noreply@example.com>"
CONTACT_TO=aadhyainfotech02@gmail.com
