# --- Core ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Payload / MongoDB
# Local dev uses the in-memory Mongo from `pnpm --filter @aadhya/website dev:db`.
# For production, set this to a MongoDB Atlas connection string.
DATABASE_URI=mongodb://127.0.0.1:27017/aadhya
PAYLOAD_SECRET=change-me-to-a-long-random-string

# --- Cloudflare R2 (media storage; optional in dev — falls back to local disk) ---
# R2_BUCKET=aadhya-media
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# R2_REGION=auto
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=

# --- Cloudflare Turnstile (spam protection; optional in dev) ---
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
